        "IFD0:Model": "CF-1",
        "IFD0:ModifyDate": "2026:10:16 12:34:56",
        "IFD0:Orientation": 1
      },
      "expect_absent": [
        "ExifIFD:ImageUniqueID",
        "ExifIFD:LensSerialNumber",
        "ExifIFD:MakerNoteUnknownText",
        "ExifIFD:OwnerName",
        "ExifIFD:SerialNumber",
        "ExifIFD:UserComment",
        "IFD0:Artist",
        "IFD0:Copyright",
        "IFD0:HostComputer",
        "IFD0:ImageDescription",

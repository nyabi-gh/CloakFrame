{
  "id": "metadata-allowlist",
  "stage": "M2 (EXIF writer)",
  "status": "normative",
  "requirement": "메타데이터 보존을 켜면 1.12.1 allowlist(Exiv2 키 31개 = 태그 30개; Exif.Photo.ISOSpeedRatings와 PhotographicSensitivity는 같은 0x8827)만 새 EXIF 블록으로 쓴다. GPS는 별도 동의가 있을 때만 GPS IFD 전체를 옮긴다. orientation은 pixel에 반영한 뒤 1. entry 128 B 초과·전체 64 KiB 초과·undefined 형식은 버린다. XMP·IPTC·JPEG comment·thumbnail·MakerNote는 쓰지 않는다. ICC는 D2 규칙을 따른다.",
  "exiv2_allowlist": [
    "Exif.Image.Make",
    "Exif.Image.Model",
    "Exif.Image.Orientation",
    "Exif.Image.DateTime",
    "Exif.Photo.DateTimeOriginal",
    "Exif.Photo.DateTimeDigitized",
    "Exif.Photo.OffsetTime",
    "Exif.Photo.OffsetTimeOriginal",
    "Exif.Photo.OffsetTimeDigitized",
    "Exif.Photo.SubSecTime",
    "Exif.Photo.SubSecTimeOriginal",
    "Exif.Photo.SubSecTimeDigitized",
    "Exif.Photo.ExposureTime",
    "Exif.Photo.FNumber",
    "Exif.Photo.ExposureProgram",
    "Exif.Photo.ISOSpeedRatings",
    "Exif.Photo.PhotographicSensitivity",
    "Exif.Photo.ExposureBiasValue",
    "Exif.Photo.MeteringMode",
    "Exif.Photo.Flash",
    "Exif.Photo.FocalLength",
    "Exif.Photo.FocalLengthIn35mmFilm",
    "Exif.Photo.ExposureMode",
    "Exif.Photo.WhiteBalance",
    "Exif.Photo.SceneCaptureType",
    "Exif.Photo.ColorSpace",
    "Exif.Photo.LensMake",
    "Exif.Photo.LensModel",
    "Exif.Photo.LensSpecification",
    "Exif.Photo.ApertureValue",
    "Exif.Photo.ShutterSpeedValue"
  ],
  "cases": [

        "ExifIFD:ColorSpace": 1,
        "ExifIFD:CreateDate": "2026:10:16 12:34:51",
        "ExifIFD:DateTimeOriginal": "2026:10:16 12:34:50",
        "ExifIFD:ExposureCompensation": -0.3333333333,
        "ExifIFD:ExposureMode": 0,
        "ExifIFD:ExposureProgram": 2,
        "ExifIFD:ExposureTime": 0.008,
        "ExifIFD:FNumber": 2.8,
        "ExifIFD:Flash": 16,
        "ExifIFD:FocalLength": 50,
        "ExifIFD:FocalLengthIn35mmFormat": 75,
        "ExifIFD:ISO": 200,
        "ExifIFD:LensInfo": "50 50 1.8 1.8",
        "ExifIFD:LensMake": "CloakLens",
        "ExifIFD:LensModel": "CL 50mm F1.8",
        "ExifIFD:MeteringMode": 5,
        "ExifIFD:OffsetTime": "+09:00",
        "ExifIFD:OffsetTimeDigitized": "+09:00",
        "ExifIFD:OffsetTimeOriginal": "+09:00",
        "ExifIFD:SceneCaptureType": 0,
        "ExifIFD:ShutterSpeedValue": "0.00797665723208745",
        "ExifIFD:SubSecTime": 123,
        "ExifIFD:SubSecTimeDigitized": 121,
        "ExifIFD:SubSecTimeOriginal": 120,
        "ExifIFD:WhiteBalance": 0,
